# ==============================================
# SERVER CONFIGURATION
# ==============================================
PORT=8080
APP_ENV=development
BASE_URL=http://localhost:8080
APP_NAME=Spot Solutions

# ==============================================
# DATABASE CONFIGURATION (Neon PostgreSQL / Standard PostgreSQL)
# ==============================================
# Direct Neon connection string (preferred):
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Individual connection parameters fallback:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=spot_solution_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# ==============================================
# AUTHENTICATION & SECURITY
# ==============================================
SESSION_SECRET=change_this_to_a_random_32_byte_secret_in_production
CSRF_SECRET=change_this_to_another_32_byte_secret_in_production
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_MAX_AGE_SECONDS=86400

# INITIAL DEFAULT ADMIN CREDENTIALS (seeded on first startup if not present)
DEFAULT_ADMIN_EMAIL=admin@spotsolutions.com
DEFAULT_ADMIN_PASSWORD=change_this_initial_password_on_first_login

# ==============================================
# SMTP / EMAIL CONFIGURATION
# Set SMTP_HOST=simulation or leave empty for local development logging
# Set valid SMTP credentials to enable real email sending via the outbox worker
# ==============================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_api_key_or_password
SMTP_FROM_EMAIL=no-reply@spotsolutions.com
SMTP_FROM_NAME=Spot Solutions
ADMIN_NOTIFICATION_EMAIL=leads@your-domain.com
NOTIFICATION_RECIPIENT_EMAIL=leads@your-domain.com
EMAIL_OUTBOX_WORKER_INTERVAL_SEC=5
EMAIL_MAX_RETRIES=5

# ==============================================
# RATE LIMITING & SECURITY
# ==============================================
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=30
CONTACT_RATE_LIMIT_MINUTES=1
MAX_BODY_SIZE_BYTES=2097152
